# ==========================================
# KEYCROVE SERVER CONFIGURATION
# ==========================================

# Application settings
NODE_ENV=development
PORT=4000
TRUST_PROXY=false

# Frontend address
APP_ORIGIN=http://localhost:5173

# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# Replace the example below with your actual
# PostgreSQL database connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME

# Use "require" when your database provider
# requires an SSL connection.
DATABASE_SSL=require

# ==========================================
# SESSION SECURITY
# ==========================================

# Replace this placeholder with a randomly
# generated secret containing at least 32 bytes.
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES

# ==========================================
# VAULT ENCRYPTION
# ==========================================

# Replace this placeholder with a valid
# Base64-encoded encryption key of 32 bytes.
KEYCROVE_ENCRYPTION_KEY=REPLACE_WITH_A_BASE64_ENCODED_32_BYTE_KEY

# ==========================================
# EMAIL CONFIGURATION
# ==========================================

# SMTP server details for password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# The sender address used by the mailer.
# This must match MAIL_FROM in mailer.js.
MAIL_FROM=
